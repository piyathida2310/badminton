generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- ENUMS --------------------
enum Role {
  ORGANIZER
  PLAYER
}

enum PlayType {
  SINGLE
  DOUBLE
}

enum HandType {
  BG
  NB
  N
  S
  P_MINUS @map("P-")
  P_PLUS  @map("P+")
}

enum MatchType {
  SINGLE
  DOUBLE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum EvaluationStatus {
  WAITING
  PASSED
  FAILED
}

enum MatchStatus {
  PENDING
  RUNNING
  FINISHED
  CANCELLED
}

enum CancellationStatus {
  REQUESTED
  REFUNDED
  REJECTED
}

enum MatchStage {
  UPPER
  LOWER
  GRAND_FINAL
  THIRD_PLACE
}

enum MatchSlot {
  P1
  P2
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// -------------------- MODELS --------------------

model User {
  id           Int       @id @default(autoincrement()) @map("id")
  userName     String?   @unique @map("user_name")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String    @unique
  password     String
  age          Int?
  gender       Gender?
  role         Role      @default(PLAYER)
  playType     PlayType? @map("play_type")
  profileImg   String?   @map("profile_img")
  gmail        String?   @unique
  clerkId      String?   @unique @map("clerk_id")
  phoneNumber  String?   @map("phone_number")
  rank         Int?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organizedTournaments Tournament[] @relation("OrganizerTournaments")
  registrations        Register[]
  confirmedPayments    Payment[]    @relation("PaymentConfirmedBy")
  histories            History[]

  @@map("users")
}

model Tournament {
  id             Int      @id @default(autoincrement())
  name           String
  location       String
  playType       PlayType @map("play_type")
  rank           String[]
  shuttlePrice   Float    @map("shuttle_price")
  maxPlayers     Int      @map("max_players")
  posterImg      String?  @map("poster_img")
  qrCodeImg      String?  @map("qr_code_img")
  startDate      DateTime @map("start_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updateAt       DateTime @updatedAt @map("updated_at")
  ruleId         Int      @map("rule_id")
  isLowerBracket Boolean  @default(false) @map("is_lower_bracket")
  isCancel       Boolean  @default(false) @map("is_cancel")
  organizerId    Int      @map("organizer_id")

  organizer User @relation("OrganizerTournaments", fields: [organizerId], references: [id])
  rule      Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  groupMatches   GroupMatch[]
  bracketMatches BracketMatch[]
  registrations  Register[]
  groups         Group[]
  summaries      Summary[]
  competition    Competition[]

  @@map("tournaments")
}

model Competition {
  id           Int      @id @default(autoincrement())
  time         DateTime
  detail       String
  rank         String[]
  tournamentId Int?     @map("tournament_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updateAt     DateTime @updatedAt @map("updated_at")

  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("competitions")
}

model Rule {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updateAt  DateTime @updatedAt @map("updated_at")

  tournament Tournament[]

  @@map("rules")
}

model Register {
  id           Int              @id @default(autoincrement())
  userId       Int              @map("user_id")
  tournamentId Int              @map("tournament_id")
  teamName     String?          @map("team_name")
  playType     HandType         @map("hand_type")
  phoneNumber  String           @map("phone_number")
  videoUrl     String?          @map("video_url")
  status       EvaluationStatus @default(WAITING)
  score        Float?
  comment      String?

  managerName     String?   @map("manager_name")
  player1Name     String?   @map("player1_name")
  player1Gender   Gender?   @map("player1_gender")
  player1Birthday DateTime? @map("player1_birthday")
  player2Name     String?   @map("player2_name")
  player2Gender   Gender?   @map("player2_gender")
  player2Phone    String?   @map("player2_phone")
  player2Birthday DateTime? @map("player2_birthday")

  groupId Int?    @map("group_id")
  group   Group? @relation(fields: [groupId], references: [id])

  user       User       @relation(fields: [userId], references: [id])
  tournament Tournament @relation(fields: [tournamentId], references: [id])
  payment    Payment?
  cancellation CancellationRequest?

  groupMatchesAsPlayer1 GroupMatch[] @relation("GroupPlayer1")
  groupMatchesAsPlayer2 GroupMatch[] @relation("GroupPlayer2")
  groupMatchesAsWinner  GroupMatch[] @relation("GroupWinner")

  bracketMatchesAsPlayer1 BracketMatch[] @relation("BracketPlayer1")
  bracketMatchesAsPlayer2 BracketMatch[] @relation("BracketPlayer2")
  bracketMatchesAsWinner  BracketMatch[] @relation("BracketWinner")

  summaries Summary[] @relation("SummaryRegister")

  @@map("registrations")
}

model CancellationRequest {
  id          Int                @id @default(autoincrement())
  registerId  Int                @unique @map("register_id")
  reason      String?
  status      CancellationStatus @default(REQUESTED)
  bankName    String?            @map("bank_name")
  accountNum  String?            @map("account_num")
  accountName String?            @map("account_name")
  qrCode      String?            @map("qr_code")
  refundSlip  String?            @map("refund_slip")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  register Register @relation(fields: [registerId], references: [id])

  @@map("cancellation_requests")
}

model Payment {
  id            Int           @id @default(autoincrement())
  registerId    Int           @unique @map("register_id")
  slipImg       String?       @map("slip_img")
  status        PaymentStatus @default(PENDING)
  confirmedById Int?          @map("confirmed_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  register    Register @relation(fields: [registerId], references: [id])
  confirmedBy User?    @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])

  @@map("payments")
}

model Group {
  id           Int      @id @default(autoincrement())
  name         String
  tournamentId Int      @map("tournament_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tournament   Tournament   @relation(fields: [tournamentId], references: [id])
  groupMatches GroupMatch[]
  registers    Register[]

  @@map("groups")
}

model GroupMatch {
  id            Int         @id @default(autoincrement())
  tournamentId  Int         @map("tournament_id")
  groupId       Int         @map("group_id")
  handType      HandType?   @map("hand_type")
  roundName     String?     @map("round_name")
  player1Id     Int?        @map("player1_id")
  matchSequence Int?        @map("match_sequence")
  player2Id     Int?        @map("player2_id")
  winnerId      Int?        @map("winner_id")
  score1        Int?        @map("score1")
  score2        Int?        @map("score2")
  sets          String?
  shuttle       Int?
  status        MatchStatus @default(PENDING)
  scheduledTime DateTime?   @map("scheduled_time")

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  group      Group      @relation(fields: [groupId], references: [id])

  player1 Register? @relation("GroupPlayer1", fields: [player1Id], references: [id])
  player2 Register? @relation("GroupPlayer2", fields: [player2Id], references: [id])
  winner  Register? @relation("GroupWinner", fields: [winnerId], references: [id])

  @@index([tournamentId])
  @@index([groupId])
  @@map("group_matches")
}

model BracketMatch {
  id            Int         @id @default(autoincrement())
  tournamentId  Int         @map("tournament_id")
  handType      HandType?   @map("hand_type")
  stage         MatchStage  @default(UPPER)
  roundSequence Int?        @map("round_sequence")
  matchSequence Int?        @map("match_sequence")
  player1Id     Int?        @map("player1_id")
  player2Id     Int?        @map("player2_id")
  winnerId      Int?        @map("winner_id")
  score1        Int?        @map("score1")
  score2        Int?        @map("score2")
  sets          String?
  shuttle       Int?
  status        MatchStatus @default(PENDING)
  scheduledTime DateTime?   @map("scheduled_time")

  winnerNextMatchId   Int?       @map("winner_next_match_id")
  winnerNextMatchSlot MatchSlot? @map("winner_next_match_slot")
  loserNextMatchId    Int?       @map("loser_next_match_id")
  loserNextMatchSlot  MatchSlot? @map("loser_next_match_slot")

  tournament Tournament @relation(fields: [tournamentId], references: [id])

  player1 Register? @relation("BracketPlayer1", fields: [player1Id], references: [id])
  player2 Register? @relation("BracketPlayer2", fields: [player2Id], references: [id])
  winner  Register? @relation("BracketWinner", fields: [winnerId], references: [id])

  previousWinnerMatch BracketMatch?  @relation("WinnerPath", fields: [winnerNextMatchId], references: [id])
  nextWinnerMatches   BracketMatch[] @relation("WinnerPath")
  previousLoserMatch  BracketMatch?  @relation("LoserPath", fields: [loserNextMatchId], references: [id])
  nextLoserMatches    BracketMatch[] @relation("LoserPath")

  @@index([tournamentId])
  @@map("bracket_matches")
}

model Summary {
  id           Int      @id @default(autoincrement())
  tournamentId Int      @map("tournament_id")
  registerId   Int      @map("register_id")
  position     Int
  totalScore   Float?   @map("total_score")
  shuttleUsed  Int?     @map("shuttle_used")
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  register   Register   @relation("SummaryRegister", fields: [registerId], references: [id])

  @@map("summaries")
}

model History {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("histories")
}