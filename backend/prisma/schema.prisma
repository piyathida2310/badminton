generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- ENUMS --------------------
enum Role {
  ORGANIZER
  PLAYER
}

enum PlayType {
  SINGLE
  DOUBLE
}

enum HandType {
  BG
  NB
  N
  S
  P_MINUS @map("P-")
  P_PLUS  @map("P+")
}

enum MatchType {
  SINGLE
  DOUBLE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum EvaluationStatus {
  WAITING
  PASSED
  FAILED
}

enum MatchStatus {
  PENDING
  RUNNING
  FINISHED
  CANCELLED
}

// New Enums for Bracket & Gender
enum MatchStage {
  GROUP
  UPPER
  LOWER
  // Optional: FINAL could be used for grand final across brackets if needed
  GRAND_FINAL
  THIRD_PLACE
}

enum MatchSlot {
  P1
  P2
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// -------------------- MODELS --------------------

// ---------- USER ----------
model User {
  id          Int       @id @default(autoincrement()) @map("user_id")
  userName    String?   @unique @map("user_name")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  email       String    @unique
  password    String
  age         Int?
  gender      Gender?   // Optional: User's primary gender
  role        Role      @default(PLAYER)
  playType    PlayType?
  profileImg  String?
  gmail       String?   @unique
  clerkId     String?   @unique @map("clerk_id")
  phoneNumber String?   @map("phone_number")
  rank        Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizedTournaments Tournament[] @relation("OrganizerTournaments")
  registrations        Register[]
  confirmedPayments    Payment[]    @relation("PaymentConfirmedBy")
  histories            History[]
}

// ---------- TOURNAMENT ----------

model Tournament {
  id             Int      @id @default(autoincrement())
  name           String
  location       String
  playType       PlayType
  rank           String[]
  shuttlePrice   Float
  maxPlayers     Int
  posterImg      String?
  qrCodeImg      String?
  startDate      DateTime
  createdAt      DateTime @default(now())
  updateAt       DateTime @updatedAt
  ruleId         Int
  isLowerBracket Boolean  @default(false)
  isCancel       Boolean  @default(false)
  organizerId    Int

  organizer User @relation("OrganizerTournaments", fields: [organizerId], references: [id])
  rule      Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  matches       Match[]
  registrations Register[]
  groups        Group[]
  summaries     Summary[]
  competition   Competition[]
}

// ---------- competition ----------

model Competition {
  id           Int      @id @default(autoincrement())
  time         DateTime
  detail       String
  rank         String[]
  tournamentId Int?
  createdAt    DateTime @default(now())
  updateAt     DateTime @updatedAt

  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

// ---------- RULE ----------
model Rule {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  tournament Tournament[]
}

// ---------- REGISTER ----------
model Register {
  id           Int              @id @default(autoincrement())
  userId       Int
  tournamentId Int
  teamName     String?
  playType     HandType
  phoneNumber  String
  videoUrl     String?
  status       EvaluationStatus @default(WAITING)
  score        Float?
  comment      String?

  // ข้อมูลผู้จัดการทีม
  managerName  String?

  // ข้อมูลผู้เล่นคนที่ 1
  player1Name     String?
  player1Gender   Gender? // New Field
  player1Birthday DateTime?

  // ข้อมูลผู้เล่นคนที่ 2 (สำหรับแบบคู่)
  player2Name     String?
  player2Gender   Gender? // New Field
  player2Phone    String?
  player2Birthday DateTime?

  // Foreign key สำหรับ Group
  groupId Int? 
  group   Group? @relation(fields: [groupId], references: [id])

  // Relations
  user       User       @relation(fields: [userId], references: [id])
  tournament Tournament @relation(fields: [tournamentId], references: [id])
  payment    Payment?

  // สำหรับ relation กับ Match
  matchesAsPlayer1 Match[] @relation("Player1")
  matchesAsPlayer2 Match[] @relation("Player2")
  matchesAsWinner  Match[] @relation("Winner")

  // สำหรับ relation กับ Summary (ถ้ามี)
  summaries Summary[] @relation("SummaryRegister")
}

// ---------- PAYMENT ----------
model Payment {
  id            Int           @id @default(autoincrement())
  registerId    Int           @unique
  slipImg       String?
  status        PaymentStatus @default(PENDING)
  confirmedById Int?
  createdAt     DateTime      @default(now())

  register    Register @relation(fields: [registerId], references: [id])
  confirmedBy User?    @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
}

// ---------- GROUP ----------
model Group {
  id           Int      @id @default(autoincrement())
  name         String
  tournamentId Int
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  matches    Match[]
  registers  Register[]
}

// ---------- MATCH ----------
model Match {
  id            Int         @id @default(autoincrement())
  tournamentId  Int
  groupId       Int?
  
  // Bracket Info
  stage         MatchStage  @default(GROUP)
  roundSequence Int?        // 1=RoundOne, 2=RoundTwo...
  matchSequence Int?        // Vertical Order: 1, 2, 3...
  
  player1Id     Int?
  player2Id     Int?
  winnerId      Int?
  
  round         String?     // Can still be used for detailed round name or text
  score1        Int?
  score2        Int?
  status        MatchStatus @default(PENDING)
  scheduledTime DateTime?

  // Pathing for Bracket (Winner Automation)
  winnerNextMatchId    Int?
  winnerNextMatchSlot  MatchSlot?
  
  // Optional: For loser bracket if needed later
  loserNextMatchId     Int?
  loserNextMatchSlot   MatchSlot?

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  group      Group?     @relation(fields: [groupId], references: [id])

  player1 Register? @relation("Player1", fields: [player1Id], references: [id])
  player2 Register? @relation("Player2", fields: [player2Id], references: [id])
  winner  Register? @relation("Winner", fields: [winnerId], references: [id])
  
  // Relations for Linked Matches
  previousWinnerMatch  Match?  @relation("WinnerPath", fields: [winnerNextMatchId], references: [id])
  nextWinnerMatches    Match[] @relation("WinnerPath")
  
  previousLoserMatch   Match?  @relation("LoserPath", fields: [loserNextMatchId], references: [id])
  nextLoserMatches     Match[] @relation("LoserPath")

  @@index([tournamentId])
  @@index([groupId])
}

// ---------- SUMMARY ----------
model Summary {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  registerId   Int
  position     Int
  totalScore   Float?
  shuttleUsed  Int?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  register   Register   @relation("SummaryRegister", fields: [registerId], references: [id])
}

// ---------- HISTORY ----------
model History {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
