generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- ENUMS --------------------
enum Role {
  ORGANIZER
  PLAYER
}

enum PlayType {
  SINGLE
  DOUBLE
}

enum HandType {
  BG
  NB
  N
  S
  P_MINUS @map("P-")
  P_PLUS  @map("P+")
}

enum MatchType {
  SINGLE
  DOUBLE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum EvaluationStatus {
  WAITING
  PASSED
  FAILED
}

enum MatchStatus {
  PENDING
  RUNNING
  FINISHED
  CANCELLED
}

// -------------------- MODELS --------------------

// ---------- USER ----------
model User {
  id         Int        @id @default(autoincrement()) @map("user_id")
  userName   String?    @map("user_name")
  firstName  String     @map("first_name")
  lastName   String     @map("last_name")
  email      String     @unique
  password   String
  age        Int?
  role       Role       @default(PLAYER)
  playType   PlayType?
  profileImg String?
  gmail      String?    @unique
  rank       Int?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  organizedTournaments Tournament[] @relation("OrganizerTournaments")
  registrations        Register[]
  confirmedPayments    Payment[]     @relation("PaymentConfirmedBy")
  histories            History[]
}

// ---------- TOURNAMENT ----------
model Tournament {
  id           Int        @id @default(autoincrement())
  name         String
  location     String
  playType     HandType
  shuttlePrice Float
  maxPlayers   Int
  posterImg    String?
  qrCodeImg    String?
  startDate    DateTime
  createdAt    DateTime @default(now())

  organizerId  Int
  organizer    User @relation("OrganizerTournaments", fields: [organizerId], references: [id])

  rules        Rule[]
  matches      Match[]
  registrations Register[]
  groups       Group[]
  summaries    Summary[]
}

// ---------- RULE ----------
model Rule {
  id           Int       @id @default(autoincrement())
  tournamentId Int
  content      String
  createdAt    DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id])
}

// ---------- REGISTER ----------
model Register {
  id           Int        @id @default(autoincrement())
  userId       Int
  tournamentId Int
  teamName     String?
  playType     HandType
  phoneNumber  String
  videoUrl     String?
  status       EvaluationStatus @default(WAITING)
  score        Float?
  comment      String?

  // Foreign key สำหรับ Group
  groupId      Int?          // <-- เพิ่มบรรทัดนี้
  group        Group? @relation(fields: [groupId], references: [id])

  // Relations
  user        User       @relation(fields: [userId], references: [id])
  tournament  Tournament @relation(fields: [tournamentId], references: [id])
  payment     Payment?

  // สำหรับ relation กับ Match
  matchesAsPlayer1 Match[] @relation("Player1")
  matchesAsPlayer2 Match[] @relation("Player2")
  matchesAsWinner  Match[] @relation("Winner")

  // สำหรับ relation กับ Summary (ถ้ามี)
  summaries Summary[] @relation("SummaryRegister")
}

// ---------- PAYMENT ----------
model Payment {
  id            Int           @id @default(autoincrement())
  registerId    Int           @unique
  slipImg       String?
  status        PaymentStatus @default(PENDING)
  confirmedById Int?
  createdAt     DateTime @default(now())

  register       Register @relation(fields: [registerId], references: [id])
  confirmedBy    User?    @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
}

// ---------- GROUP ----------
model Group {
  id           Int       @id @default(autoincrement())
  name         String
  tournamentId Int
  createdAt    DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  matches      Match[]
  registers    Register[]
}

// ---------- MATCH ----------
model Match {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  groupId      Int?
  player1Id    Int?
  player2Id    Int?
  winnerId     Int?
  round        String?
  score1       Int?
  score2       Int?
  status       MatchStatus @default(PENDING)
  scheduledTime DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  group      Group?     @relation(fields: [groupId], references: [id])

  player1    Register?  @relation("Player1", fields: [player1Id], references: [id])
  player2    Register?  @relation("Player2", fields: [player2Id], references: [id])
  winner     Register?  @relation("Winner", fields: [winnerId], references: [id])

  @@index([tournamentId])
  @@index([groupId])
}

// ---------- SUMMARY ----------
model Summary {
  id            Int        @id @default(autoincrement())
  tournamentId  Int
  registerId    Int
  position      Int
  totalScore    Float?
  shuttleUsed   Int?
  createdAt     DateTime @default(now())

  tournament    Tournament @relation(fields: [tournamentId], references: [id])
  register      Register   @relation("SummaryRegister", fields: [registerId], references: [id])
}


// ---------- HISTORY ----------
model History {
  id        Int       @id @default(autoincrement())
  userId    Int
  action    String
  createdAt DateTime  @default(now())

  user      User @relation(fields: [userId], references: [id])
}
