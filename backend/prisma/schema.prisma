generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- ENUMS --------------------
enum Role {
  ORGANIZER
  PLAYER
}

enum PlayType {
  SINGLE
  DOUBLE
}

enum HandType {
  BG
  NB
  N
  S
  P_MINUS @map("P-")
  P_PLUS  @map("P+")
}

enum MatchType {
  SINGLE
  DOUBLE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum EvaluationStatus {
  WAITING
  PASSED
  FAILED
}

enum MatchStatus {
  PENDING
  RUNNING
  FINISHED
  CANCELLED
}

// New Enums for Bracket & Gender
enum MatchStage {
  UPPER
  LOWER
  GRAND_FINAL
  THIRD_PLACE
}

enum MatchSlot {
  P1
  P2
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// -------------------- MODELS --------------------

// ---------- USER ----------
model User {
  id          Int       @id @default(autoincrement()) @map("user_id")
  userName    String?   @unique @map("user_name")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  email       String    @unique
  password    String
  age         Int?
  gender      Gender?   // Optional: User's primary gender
  role        Role      @default(PLAYER)
  playType    PlayType?
  profileImg  String?
  gmail       String?   @unique
  clerkId     String?   @unique @map("clerk_id")
  phoneNumber String?   @map("phone_number")
  rank        Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizedTournaments Tournament[] @relation("OrganizerTournaments")
  registrations        Register[]
  confirmedPayments    Payment[]    @relation("PaymentConfirmedBy")
  histories            History[]
}

// ---------- TOURNAMENT ----------

model Tournament {
  id             Int      @id @default(autoincrement())
  name           String
  location       String
  playType       PlayType
  rank           String[]
  shuttlePrice   Float
  maxPlayers     Int
  posterImg      String?
  qrCodeImg      String?
  startDate      DateTime
  createdAt      DateTime @default(now())
  updateAt       DateTime @updatedAt
  ruleId         Int
  isLowerBracket Boolean  @default(false)
  isCancel       Boolean  @default(false)
  organizerId    Int

  organizer User @relation("OrganizerTournaments", fields: [organizerId], references: [id])
  rule      Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  groupMatches   GroupMatch[]
  bracketMatches BracketMatch[]
  registrations  Register[]
  groups         Group[]
  summaries      Summary[]
  competition    Competition[]
}

// ---------- competition ----------

model Competition {
  id           Int      @id @default(autoincrement())
  time         DateTime
  detail       String
  rank         String[]
  tournamentId Int?
  createdAt    DateTime @default(now())
  updateAt     DateTime @updatedAt

  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

// ---------- RULE ----------
model Rule {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  tournament Tournament[]
}

// ---------- REGISTER ----------
model Register {
  id           Int              @id @default(autoincrement())
  userId       Int
  tournamentId Int
  teamName     String?
  playType     HandType
  phoneNumber  String
  videoUrl     String?
  status       EvaluationStatus @default(WAITING)
  score        Float?
  comment      String?

  // ข้อมูลผู้จัดการทีม
  managerName  String?

  // ข้อมูลผู้เล่นคนที่ 1
  player1Name     String?
  player1Gender   Gender? // New Field
  player1Birthday DateTime?

  // ข้อมูลผู้เล่นคนที่ 2 (สำหรับแบบคู่)
  player2Name     String?
  player2Gender   Gender? // New Field
  player2Phone    String?
  player2Birthday DateTime?

  // Foreign key สำหรับ Group
  groupId Int? 
  group   Group? @relation(fields: [groupId], references: [id])

  // Relations
  user       User       @relation(fields: [userId], references: [id])
  tournament Tournament @relation(fields: [tournamentId], references: [id])
  payment    Payment?

  // สำหรับ relation กับ GroupMatch
  groupMatchesAsPlayer1 GroupMatch[] @relation("GroupPlayer1")
  groupMatchesAsPlayer2 GroupMatch[] @relation("GroupPlayer2")
  groupMatchesAsWinner  GroupMatch[] @relation("GroupWinner")

  // สำหรับ relation กับ BracketMatch
  bracketMatchesAsPlayer1 BracketMatch[] @relation("BracketPlayer1")
  bracketMatchesAsPlayer2 BracketMatch[] @relation("BracketPlayer2")
  bracketMatchesAsWinner  BracketMatch[] @relation("BracketWinner")

  // สำหรับ relation กับ Summary (ถ้ามี)
  summaries Summary[] @relation("SummaryRegister")
}

// ---------- PAYMENT ----------
model Payment {
  id            Int           @id @default(autoincrement())
  registerId    Int           @unique
  slipImg       String?
  status        PaymentStatus @default(PENDING)
  confirmedById Int?
  createdAt     DateTime      @default(now())

  register    Register @relation(fields: [registerId], references: [id])
  confirmedBy User?    @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
}

// ---------- GROUP ----------
model Group {
  id           Int      @id @default(autoincrement())
  name         String
  tournamentId Int
  createdAt    DateTime @default(now())

  tournament   Tournament   @relation(fields: [tournamentId], references: [id])
  groupMatches GroupMatch[]
  registers    Register[]
}

// ---------- GROUP MATCH (รอบแบ่งกลุ่ม) ----------
model GroupMatch {
  id            Int         @id @default(autoincrement())
  tournamentId  Int
  groupId       Int

  handType      HandType?
  roundName     String?     // "R1", "R2", "R3"

  player1Id     Int?
  matchSequence Int?        // ลำดับแมตช์ (1, 2, 3...)
  player2Id     Int?
  winnerId      Int?

  score1        Int?
  score2        Int?
  sets          String?     // "21:19, 18:21"
  shuttle       Int?        // จำนวนลูกแบด
  status        MatchStatus @default(PENDING)
  scheduledTime DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  group      Group      @relation(fields: [groupId], references: [id])

  player1 Register? @relation("GroupPlayer1", fields: [player1Id], references: [id])
  player2 Register? @relation("GroupPlayer2", fields: [player2Id], references: [id])
  winner  Register? @relation("GroupWinner", fields: [winnerId], references: [id])

  @@index([tournamentId])
  @@index([groupId])
}

// ---------- BRACKET MATCH (สายแข่ง) ----------
model BracketMatch {
  id            Int         @id @default(autoincrement())
  tournamentId  Int

  handType      HandType?
  stage         MatchStage  @default(UPPER)  // UPPER, LOWER, GRAND_FINAL, THIRD_PLACE
  roundSequence Int?        // 1=รอบแรก, 2=รอบสอง...
  matchSequence Int?        // ลำดับแมตช์ในรอบ: 1, 2, 3...

  player1Id     Int?
  player2Id     Int?
  winnerId      Int?

  score1        Int?
  score2        Int?
  sets          String?     // "21:19, 18:21"
  shuttle       Int?        // จำนวนลูกแบด
  status        MatchStatus @default(PENDING)
  scheduledTime DateTime?

  // เส้นทาง Bracket (เลื่อนผู้เล่นอัตโนมัติ)
  winnerNextMatchId    Int?
  winnerNextMatchSlot  MatchSlot?
  loserNextMatchId     Int?
  loserNextMatchSlot   MatchSlot?

  tournament Tournament @relation(fields: [tournamentId], references: [id])

  player1 Register? @relation("BracketPlayer1", fields: [player1Id], references: [id])
  player2 Register? @relation("BracketPlayer2", fields: [player2Id], references: [id])
  winner  Register? @relation("BracketWinner", fields: [winnerId], references: [id])

  // Relations for Linked Matches
  previousWinnerMatch  BracketMatch?  @relation("WinnerPath", fields: [winnerNextMatchId], references: [id])
  nextWinnerMatches    BracketMatch[] @relation("WinnerPath")

  previousLoserMatch   BracketMatch?  @relation("LoserPath", fields: [loserNextMatchId], references: [id])
  nextLoserMatches     BracketMatch[] @relation("LoserPath")

  @@index([tournamentId])
}

// ---------- SUMMARY ----------
model Summary {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  registerId   Int
  position     Int
  totalScore   Float?
  shuttleUsed  Int?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  register   Register   @relation("SummaryRegister", fields: [registerId], references: [id])
}

// ---------- HISTORY ----------
model History {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
