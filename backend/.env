# Database
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/badminton?schema=public&timezone=Asia/Bangkok"

# Application
PORT=8000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=super-access-secret-32+
JWT_ACCESS_EXPIRES=1m
JWT_REFRESH_SECRET=super-refresh-secret-32+
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=jwt-jet-system
JWT_AUDIENCE=jwt-users

# Password Reset (ยังไม่ได้ใช้งานใน Express เวอร์ชันนี้ แต่เก็บไว้ให้ครบ)
PASSWORD_RESET_EXPIRES=15
PASSWORD_RESET_SALT_ROUNDS=12
