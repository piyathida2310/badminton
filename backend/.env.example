# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/badminton_db?schema=public"

# ==========================================
# Server Configuration
# ==========================================
PORT=3001
NODE_ENV="development"
COOKIE_DOMAIN="localhost"

# ==========================================
# JWT Authentication & Security
# ==========================================
JWT_ACCESS_SECRET="super-access-secret-32+"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_SECRET="super-refresh-secret-32+"
JWT_REFRESH_EXPIRES="7d"
JWT_ISSUER="badminton-app"
JWT_AUDIENCE="badminton-users"

PASSWORD_RESET_EXPIRES="15"
PASSWORD_RESET_SALT_ROUNDS="12"

# ==========================================
# MinIO / S3 Object Storage
# ==========================================
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ROOT_USER="admin"
MINIO_ROOT_PASSWORD="password"
MINIO_BUCKET="badminton-assets"

# ==========================================
# OpenAI (For AI Grouping / Chain of Thought)
# ==========================================
OPENAI_API_KEY="sk-proj-..."

# ==========================================
# Swagger API Documentation Auth
# ==========================================
SWAGGER_USER="admin"
SWAGGER_PASSWORD="password"
